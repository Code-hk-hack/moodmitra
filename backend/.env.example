# ===================================================
# MoodMitra Backend Configuration & Credentials
# Copy this file to .env and insert your API keys
# ===================================================

PORT=5000

# 1. Groq Cloud API Key (for Cognitive Brain & Whisper STT)
# Get key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=350

# 2. Google Gemini API Key (for Kinematic & Emotional Director)
# Get key from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# 3. Gnani.ai Partner Credentials (Flagship timbre-v2.5 TTS)
GNANI_API_KEY=your_gnani_api_key_here
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_LANG=en-IN
GNANI_TTS_MODEL=timbre-v2.5
